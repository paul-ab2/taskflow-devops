{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow - a production-style task management REST API (JWT auth, CRUD, metrics) used to demonstrate a 7-stage Jenkins CI/CD pipeline.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/build-info.js",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 10 -f checkstyle -o reports/eslint-checkstyle.xml && eslint . -f json -o reports/eslint.json",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:smoke": "jest --config jest.smoke.config.js --ci",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sonar": "sonar-scanner-npm"
  },
  "keywords": [
    "devops",
    "jenkins",
    "express",
    "ci-cd"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sonar/scan": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-formatter-checkstyle": "^9.0.1",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.0"
  },
  "files": [
    "src",
    "public",
    "build-info.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paul-ab2/taskflow-devops.git"
  }
}
